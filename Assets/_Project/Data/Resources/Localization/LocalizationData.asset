  - key: match_event_fk_indirect_1
    korean: "\uAC04\uC811 \uD504\uB9AC\uD0A5 \u2014 \uC9E7\uAC8C \uC5F0\uACB0."
    english: "Indirect free kick \u2014 played short."
  - key: match_event_fk_indirect_2
    korean: "{player}\uAC00 \uBC15\uC2A4 \uC548\uC73C\uB85C \uB744\uC6B4\uB2E4."
    english: '{player} lofts it into the box.'
  - key: match_event_fk_indirect_3
