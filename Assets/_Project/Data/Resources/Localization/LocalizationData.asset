    english: Dominant {home} win {homeScore}-{awayScore} against {away}.
  - key: match_report_win_3
    korean: "{home}, {away}\uC5D0 {homeScore}-{awayScore} \uC2B9."
    english: '{home} beat {away} {homeScore}-{awayScore}.'
  - key: match_report_win_4
    korean: "\uCE58\uC5F4\uD55C \uC811\uC804 \uB05D\uC5D0 {home}\uC774 {away}\uB97C
      \uAEBE\uC5C8\uB2E4."
    english: '{home} edge {away} in a tight contest.'
