{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh project item-list *)",
      "Bash(gh label list *)",
      "Bash(dotnet csharpier *)",
      "Bash(dotnet tool *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(dotnet csharpier *)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./obj/**)",
      "Read(./Build/**)",
      "Read(./Builds/**)",
      "Read(./UserSettings/**)",
      "Read(./**/*.csproj)",
      "Read(./**/*.sln)",
      "Read(./**/*.suo)",
      "Write(./**/*.meta)",
      "Edit(./**/*.meta)",
      "Write(./**/*.unity)",
      "Edit(./**/*.unity)",
      "Write(./**/*.prefab)",
      "Edit(./**/*.prefab)",
      "Edit(./Packages/packages-lock.json)",
      "Edit(./ProjectSettings/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(Remove-Item -Recurse -Force *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/csharpier-format.ps1"
          }
        ]
      }
    ]
  }
}
